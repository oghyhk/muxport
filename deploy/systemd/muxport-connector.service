[Unit]
Description=Muxport Host Connector Daemon
Documentation=https://github.com/oghyhk/muxport
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
User=muxport
Group=muxport
UMask=0077
StateDirectory=muxport
StateDirectoryMode=0700
WorkingDirectory=/var/lib/muxport
EnvironmentFile=/etc/muxport/connector.env
ExecStart=/usr/local/bin/muxport-connector
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
